# Copy this file to .env and replace every placeholder.
# Never commit .env or paste these values into chat.

DASHSCOPE_API_KEY=replace-with-dashscope-api-key
COS_SECRET_ID=replace-with-tencent-cos-secret-id
COS_SECRET_KEY=replace-with-tencent-cos-secret-key

# Runtime bucket settings are command-line options, but keeping them here is convenient:
COS_BUCKET_NAME=replace-with-private-cos-bucket
COS_REGION=ap-shanghai

# Optional: use existing macOS Keychain service names when env credentials are omitted.
# DASHSCOPE_KEYCHAIN_SERVICE=DASHSCOPE_API_KEY
# COS_SECRET_ID_KEYCHAIN_SERVICE=COS_SECRET_ID
# COS_SECRET_KEY_KEYCHAIN_SERVICE=COS_SECRET_KEY
# KEYCHAIN_ACCOUNT=your-keychain-account
